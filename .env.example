# Database
DATABASE_URL=sqlite+aiosqlite:///./radar_licitacoes.db

# JWT
JWT_SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Features
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_SCHEDULER=false
TEST_MODE=true

# Logging
LOG_LEVEL=INFO

# API
API_TITLE=Radar de Licitações
API_VERSION=1.0.0
API_DESCRIPTION=Sistema de monitoramento de licitações públicas

# PNCP
PNCP_API_URL=https://pncp.gov.br/api/consulta/v1
PNCP_SYNC_DAYS=7

# Notificações (quando habilitadas)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
