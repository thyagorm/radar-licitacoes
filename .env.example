# Configuração SMTP (Exemplo Gmail: precisa de Senha de App)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_NAME="Radar de Editais"

# WhatsApp API (Exemplo Evolution API)
WHATSAPP_API_URL=https://sua-instancia.com/message/sendText/nome_instancia
WHATSAPP_API_KEY=seu_token_aqui
